# Copy this file to `.env` and adjust values as needed.
# `.env` is git-ignored, so your local settings stay local.

# ---- Server ----
PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to hit the API / socket.
CORS_ORIGIN=http://localhost:5173

# ---- Binance WebSocket feed ----
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
# Base delay before attempting to reconnect after a dropped connection.
BINANCE_RECONNECT_DELAY_MS=3000
# Reconnect delay is doubled on each retry, capped at this value.
BINANCE_MAX_RECONNECT_DELAY_MS=30000

# ---- CoinGecko API ----
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COIN_ID=bitcoin
# How long (ms) to cache the /api/coin-info response before refetching.
COIN_INFO_CACHE_MS=30000
# Optional: CoinGecko API key if you have a Pro/Demo plan.
COINGECKO_API_KEY=

# ---- App behaviour ----
# Trade value (USD) at or above which a "whale alert" fires.
WHALE_THRESHOLD_USD=500000
# How many recent trades to keep in memory.
MAX_STORED_TRADES=100
# How many trades /api/recent-trades returns.
RECENT_TRADES_RESPONSE_LIMIT=50
