# Copy this file to `.env` and adjust values as needed.
# `.env` is git-ignored, so your local settings stay local.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Leave blank to use the Vite dev proxy (see vite.config.js) / same-origin
# deployment. Set to a full URL to point the UI at a separately hosted API.
VITE_API_BASE_URL=
VITE_SOCKET_URL=

# Cosmetic
VITE_APP_NAME=Whale Watcher
VITE_COIN_SYMBOL=BTC/USDT

# Behaviour (keep in sync with backend/.env if you change these)
VITE_WHALE_THRESHOLD_USD=500000
VITE_MAX_TRADES_IN_MEMORY=100
VITE_CHART_WINDOW_SIZE=60
VITE_WHALE_ALERT_DISPLAY_MS=4000

# Used by vite.config.js dev proxy to reach the backend during `npm run dev`.
VITE_DEV_PROXY_TARGET=http://localhost:3000
